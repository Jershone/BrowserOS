{
  "name": "BrowserOS Mint Cinnamon Desktop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Cinnamon Desktop",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "remoteUser": "vscode"
}
